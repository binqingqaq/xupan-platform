XUPAN_DB_URL=jdbc:mysql://127.0.0.1:3306/xupan_platform?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
XUPAN_DB_USERNAME=xupan_app
XUPAN_DB_PASSWORD=replace-with-a-server-only-password
SPRING_PROFILES_ACTIVE=prod
XUPAN_LOG_LEVEL=INFO
XUPAN_APP_LOG_LEVEL=INFO
XUPAN_LOG_FILE=/opt/xupan-platform/logs/xupan-server.log
XUPAN_LOG_MAX_FILE_SIZE=50MB
XUPAN_LOG_MAX_HISTORY_DAYS=30
XUPAN_LOG_TOTAL_SIZE_CAP=2GB
