[Unit]
Description=Xupan Platform health check
After=xupan-server.service

[Service]
Type=oneshot
User=xupan
Group=xupan
ExecStart=/bin/bash /opt/xupan-platform/current/xupan-healthcheck.sh
SyslogIdentifier=xupan-healthcheck
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
