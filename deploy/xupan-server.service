[Unit]
Description=Xupan Platform Spring Boot service
After=network-online.target mysqld.service
Wants=network-online.target

[Service]
Type=simple
User=xupan
Group=xupan
WorkingDirectory=/opt/xupan-platform/current
EnvironmentFile=/etc/xupan-platform/xupan.env
SyslogIdentifier=xupan-server
StandardOutput=journal
StandardError=journal
ExecStart=/www/server/java/jdk-21.0.2/bin/java -Xms256m -Xmx512m -XX:+UseSerialGC -XX:ErrorFile=/opt/xupan-platform/logs/hs_err_pid%p.log -jar /opt/xupan-platform/current/xupan-server.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/xupan-platform

[Install]
WantedBy=multi-user.target
